# =========================================================================
# ЭтоЯTV — корневой справочник переменных окружения
# Реальные секреты кладите в:
#   db/.env   rtmp/.env   web/.env
# (скопируйте из соответствующих *.env.example).
# Этот файл — обзор всех ключевых ключей; в git не коммитьте .env.
# =========================================================================

# --- Общее ---
# TYPE=production | staging   (влияет на часть поведения / cookie domain)
TYPE=production

# --- MySQL (db + web + rtmp/worker) ---
DB_HOST=127.0.0.1
DB_USER=yatv_user
DB_PASSWORD=change_me_strong_db_password
DB_NAME=yatv
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# --- Web (порт 3001) / Admin (порт 3002) ---
PORT=3001
APP_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
SESSION_SECRET=generate_a_long_random_string_here
SESSION_DOMAIN=
# Версия статики для cache-bust (?v=) — обычно git short hash или timestamp
ASSET_VERSION=

# SMTP
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_password

# hCaptcha (регистрация / антиспам)
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Telegram (опционально, алерты персоналу)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Boosty (опционально)
BOOSTY_BLOG_NAME=
BOOSTY_DEVICE_ID=
BOOSTY_ACCESS_TOKEN=
BOOSTY_REFRESH_TOKEN=
BOOSTY_EXPIRES_AT=0

# --- Медиа / CDN ---
# Локальная разработка: MEDIA_STORAGE_PATH=./samples/media  и CDN_BASE_URL=
# Прод: общий диск (SMB/NFS) + CDN_BASE_URL=https://cdn.yourdomain.com
MEDIA_STORAGE_PATH=/mnt/smb_media/public
CDN_BASE_URL=

# --- MediaMTX / RTMP / HLS / WHIP ---
RTMP_INGEST_URL=rtmp://kctv.yourdomain.com:1935/live
RTMP_STREAM_URL=https://kctv.yourdomain.com/live
RTMP_API_URL=https://kctv.yourdomain.com
RTMP_LOCAL_STREAM_URL=http://127.0.0.1:8000/live
RTMP_API_USER=mediamtx_api_user
RTMP_API_PASS=change_me_strong_rtmp_api_password
RTMP_SERVER_IP=127.0.0.1
RTMP_API_PORT=9997

# IP веб-приложения для auth webhook MediaMTX (из rtmp-контейнера)
WEB_SERVER_IP=127.0.0.1
AUTH_WEB_IP=127.0.0.1

# Live ABR (по умолчанию выключен — экономит CPU)
LIVE_ABR_ENABLED=0
LIVE_ABR_THREADS=1

# MediaMTX watchdog
MTX_WATCHDOG_INTERVAL=20
MTX_WATCHDOG_TIMEOUT=3
MTX_WATCHDOG_MAX_FAILS=3

# --- i18n (опционально) ---
# WEBLATE_URL=https://weblate.yourdomain.com
# LibreTranslate / MT для UGC — если настроено в коде/окружении

                      <div class="api-card">
                        <div class="api-header">
                          <span class="method-badge get">GET</span>
                          <div class="api-url-wrapper">
                            <span class="api-url" id="url-records">/api/public/channels/:shortname/records</span>
                            <button class="btn-copy" onclick="copyText('url-records')">📋</button>
                          </div>
                        </div>

                        <h3 style="color:#6fdeee; font-size: 14px; margin-bottom:0;">Интерактивная песочница</h3>
                        <div class="playground-panel">
